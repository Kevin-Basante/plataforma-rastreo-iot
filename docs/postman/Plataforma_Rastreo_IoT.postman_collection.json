{
  "info": {
    "name": "Plataforma de Rastreo IoT - API",
    "description": "Peticiones de la API organizadas por historia de usuario.\n\n1. Ejecuta 00 Inicio > Salud de la API (despierta Render).\n2. Ejecuta uno de los Login: el token se guarda solo.\n3. Ejecuta las carpetas en orden: las peticiones Listar guardan los ids que usan las siguientes.\n\nContraseña de todas las cuentas demo: Rastreo2026.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const ahora = new Date();",
          "pm.collectionVariables.set('hasta', ahora.toISOString());",
          "pm.collectionVariables.set('desde', new Date(ahora - 24*3600*1000).toISOString());"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://rastreo-iot-api.onrender.com"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "dispositivoId",
      "value": ""
    },
    {
      "key": "vehiculoId",
      "value": ""
    },
    {
      "key": "geocercaId",
      "value": ""
    },
    {
      "key": "alertaId",
      "value": ""
    },
    {
      "key": "subflotaId",
      "value": ""
    },
    {
      "key": "vehiculoFlotaId",
      "value": ""
    },
    {
      "key": "desde",
      "value": ""
    },
    {
      "key": "hasta",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Inicio",
      "item": [
        {
          "name": "Salud de la API",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/salud",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "salud"
              ]
            },
            "description": "Despierta la API en Render (la primera vez tarda ~50 s).",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login Laura (Usuario Hogar B2C)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Inicia sesión y guarda el token en la variable {{token}}. Las demás peticiones lo usan solas.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"laura.martinez@correo.co\",\n  \"contrasena\": \"Rastreo2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login correcto (200)', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set('token', r.token);",
                  "console.log('Sesión de', r.usuario.nombre, '-', r.usuario.rol);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Andrés (Admin de Flota B2B)",
